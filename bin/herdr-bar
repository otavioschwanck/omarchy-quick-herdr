#!/usr/bin/env python3
"""Bridge between the otavio.quick-herdr bar widget and Herdr.

Prints one line of JSON on stdout for the QML side to read. Every command
exits 0 and reports failure inside that JSON -- the widget always has
something to draw, and a stopped Herdr server must not look like a broken
helper.

Usage: herdr-bar [--session NAME] [--remote SSH_TARGET] <command> [args]

Commands:
  snapshot [--messages]   one machine's state: counts, a row per agent and,
                          with --messages, what each one last said
  all [--messages] [--local] [--remote A]...
                          the agents of every machine that is on, in parallel
  focus <pane_id>         focus the agent in Herdr and the window running the
                          client
  send <pane_id>          send the text arriving on stdin to the agent; when it
                          is stopped in a dialog, refuse with esc first
  answer <pane_id> <n> [label] [--with-text]
                          choose option <n> of a stopped agent's dialog; with
                          --with-text, write into the field it opens
  pick <machine|.|-> <pane> [cwd]
                          set (or clear) the text field's target
  disconnect <target>     close the multiplexed tunnel of a machine turned off
  prs                     refresh the PR cache (the only one that hits the net)
  hosts                   Tailscale machines usable as a --remote target
  config get              this instance's entry in shell.json
  config set <key> <value> [--json]
                          write one setting of this instance

With --remote, every Herdr command travels over SSH to that machine, and the
window `focus` looks for is the local client opened with `herdr --remote
TARGET` or `ssh -t TARGET herdr`. The connection is multiplexed
(ControlMaster), because a widget refreshing every few seconds cannot pay for
an SSH handshake per refresh.

The text for `send` comes on stdin and never on argv: one line, newline
terminated. A prompt is not a secret, but argv shows up in the `ps` of every
process on the machine, and agent prompts tend to carry paths, client names
and snippets of code.

`snapshot` never hits the network: it reads the cache `prs` wrote. They are
different rhythms -- the counts want 4 seconds, and one GitHub call per
repository neither survives nor needs that pace.
"""

import json
import os
import re
import select
import shlex
import subprocess
import sys
import threading
import time

DEFAULT_SESSION = "default"

CACHE_DIR = os.path.join(
    os.environ.get("XDG_CACHE_HOME", os.path.expanduser("~/.cache")),
    "omarchy-quick-herdr",
)
STATE_DIR = os.path.join(
    os.environ.get("XDG_STATE_HOME", os.path.expanduser("~/.local/state")),
    "omarchy-quick-herdr",
)

# TTL for the PR cache. A PR never changes number, so what expires here is
# "this branch has no PR yet" -- the only case worth asking again, and the
# only reason the TTL is not infinite.
PR_TTL = 900
PR_TTL_EMPTY = 120
GH_TTL = 300

# Ceilings on everything arriving from outside this process: the Herdr reply,
# the gh reply, another terminal's buffer, the cache some other invocation
# wrote. A socket dumping megabytes must not bloat the bar, which runs inside
# the same process as the rest of the desktop.
MAX_OUTPUT = 4 * 1024 * 1024
MAX_CACHE = 2 * 1024 * 1024
MAX_TEXT = 32 * 1024
MAX_REPOS_PER_RUN = 12
MAX_CACHE_ENTRIES = 200

# How many agents get a terminal read per refresh. Each read is one call;
# locally that is microseconds, but over SSH they are round trips, and a
# session with thirty agents cannot stall the bar.
MAX_READS = 24
BUFFER_LINES = 90
# Ceiling for one message. Deliberately high: it exists so a strange buffer
# cannot dump a whole screen into the panel, not to shorten conversation --
# expanded, the row shows the sentence whole, and cutting mid-sentence is
# worse than spending height.
MAX_MESSAGE = 1200
# How many messages each row carries. The list shows the last one; expanding
# shows every one of them, which is why they all arrive in the same payload.
#
# High enough to cover a whole screen of conversation, because that is all
# there is: an agent on the alternate screen leaves no scrollback, so asking
# for more lines returns the same content. There is nothing further back to
# fetch as you scroll -- what fits on its screen is the history.
#
# It costs almost nothing: going from 4 to 20 grew the payload of nine agents
# across two machines from 11 KB to 16 KB, because few buffers hold that many.
MAX_MESSAGES = 20
# How many context lines of the dialog come along. A ceiling because a large
# diff cannot become the whole panel; the last ones because the request sits
# against the question, and what is further up is history.
MAX_CONTEXT = 24
# A dialog's question goes whole: it is what you decide on, and the ceiling
# here only exists so a strange buffer cannot dump a screen into the panel.
MAX_QUESTION = 600
# An option's label goes whole for the same reason as the question: the
# decision lives in it. "Yes, and always allow access to /home/..." cut
# mid-path becomes a "yes" with no object, which is exactly what you needed
# to read before clicking.
MAX_LABEL = 240

# A fixed file in /tmp is convenient and shared: anyone could have planted a
# symlink there first. O_NOFOLLOW refuses to follow one, so the worst case is
# logging nothing -- and never writing into somebody else's file.
LOG = "/tmp/omarchy-quick-herdr.log"
MAX_LOG = 1024 * 1024
LOG_TAIL = 256 * 1024

TIMEOUT_HERDR = 5
TIMEOUT_SSH = 15
TIMEOUT_GIT = 5
TIMEOUT_GH = 20
TIMEOUT_HYPR = 5
TIMEOUT_STDIN = 5

# idle and done are the same state underneath: done is the idle of work that
# finished with nobody watching. They count together as "idle" and only split
# in the list, where you can mark what finished while you were away.
STATUSES = ("working", "blocked", "idle", "done", "unknown")

# List order: what asks for you now, then what is moving, then what finished
# while you were away, then what is simply waiting.
URGENCY = {"blocked": 0, "working": 1, "done": 2, "idle": 3, "unknown": 4}

SESSION = DEFAULT_SESSION

# The current machine is per thread, not per module: machines are queried in
# parallel, and a global would be swapped by one thread under another. This
# used to be a subprocess per machine, which bought the same isolation at the
# price of a whole Python interpreter per machine on every refresh.
_TARGET = threading.local()


def remote():
    return getattr(_TARGET, "remote", "")


def use_remote(target):
    _TARGET.remote = target or ""


# --------------------------------------------------------------- utilities


def reply(**campos):
    campos.setdefault("ok", True)
    campos.setdefault("error", "")
    sys.stdout.write(json.dumps(campos, ensure_ascii=False) + "\n")
    sys.exit(0)


def fail(message, **campos):
    log_event("err", message=str(message)[:300])
    reply(ok=False, error=str(message)[:400], **campos)


def log_event(evento, **campos):
    """One line in the log. Never raises: a log is diagnosis, not functionality."""
    parts = ["%s %s" % (time.strftime("%Y-%m-%dT%H:%M:%S"), evento)]
    if remote():
        parts.append("remote=%s" % remote())
    for key, value in campos.items():
        if value not in ("", None):
            parts.append("%s=%s" % (key, str(value).replace("\n", " ")[:300]))
    line = " ".join(parts) + "\n"

    try:
        if os.path.exists(LOG) and os.path.getsize(LOG) > MAX_LOG:
            with open(LOG, "rb") as fh:
                fh.seek(-LOG_TAIL, os.SEEK_END)
                cauda = fh.read()
            with open(LOG, "wb") as fh:
                fh.write(cauda)
        fd = os.open(LOG, os.O_WRONLY | os.O_CREAT | os.O_APPEND | os.O_NOFOLLOW, 0o600)
        try:
            os.write(fd, line.encode("utf-8", "replace"))
        finally:
            os.close(fd)
    except OSError:
        pass


def run(argv, timeout, cwd=None):
    """Runs argv with no shell. Returns (code, stdout, stderr) and never raises."""
    try:
        proc = subprocess.run(argv, cwd=cwd, capture_output=True, timeout=timeout, check=False)
    except FileNotFoundError:
        return (127, "", "%s not found" % argv[0])
    except subprocess.TimeoutExpired:
        return (124, "", "%s timed out after %ss" % (argv[0], timeout))
    except OSError as err:
        return (126, "", str(err))

    return (
        proc.returncode,
        proc.stdout[:MAX_OUTPUT].decode("utf-8", "replace"),
        proc.stderr[:4096].decode("utf-8", "replace"),
    )


def read_prompt():
    """The prompt from stdin, up to EOF.

    A whole read and not one line: the field is multi-line, and a prompt cut at
    the first newline would arrive as its own first sentence -- which reads like
    a complete instruction and is not one.

    The deadline exists because stdin only ends when the caller closes it. If
    something forgets to, the worst case is a helper that answers late rather
    than one that hangs holding the widget's action open forever.
    """
    data = b""
    deadline = time.time() + TIMEOUT_STDIN

    while len(data) < MAX_TEXT and time.time() < deadline:
        if not select.select([sys.stdin], [], [], 0.2)[0]:
            continue
        chunk = os.read(sys.stdin.fileno(), 4096)
        if not chunk:
            break
        data += chunk

    return data.decode("utf-8", "replace").strip()


def json_from(text):
    try:
        return json.loads(text)
    except (ValueError, TypeError):
        return None


def read_json(path, teto=MAX_CACHE):
    try:
        if os.path.getsize(path) > teto:
            return {}
        with open(path, "r", encoding="utf-8") as fh:
            value = json.load(fh)
    except (OSError, ValueError):
        return {}
    return value if isinstance(value, dict) else {}


def write_json(path, value):
    """Atomic write: the widget reads these files at any moment."""
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        tmp_path = "%s.tmp.%d" % (path, os.getpid())
        with open(tmp_path, "w", encoding="utf-8") as fh:
            json.dump(value, fh, ensure_ascii=False)
        os.replace(tmp_path, path)
    except OSError:
        pass


def scope():
    """Filename suffix separating local from each remote and each session."""
    target = re.sub(r"[^A-Za-z0-9_.@-]", "_", remote()) if remote() else "local"
    return "%s-%s" % (target, re.sub(r"[^A-Za-z0-9_.-]", "_", SESSION))


def pr_cache_path():
    return os.path.join(CACHE_DIR, "prs-%s.json" % scope())


def default_path():
    return os.path.join(STATE_DIR, "default-%s.json" % scope())


# -------------------------------------------------------------------- herdr


def ssh_prefix():
    """Multiplexa a conexao: sem isso, cada atualizacao paga um handshake.

    O socket de controle fica no cache e persiste alguns minutos depois da
    ultima chamada, entao a atualizacao seguinte reaproveita o mesmo tunel.
    """
    try:
        os.makedirs(CACHE_DIR, exist_ok=True)
    except OSError:
        pass
    return [
        "ssh",
        "-o", "BatchMode=yes",
        "-o", "ConnectTimeout=5",
        "-o", "ControlMaster=auto",
        "-o", "ControlPath=%s/ssh-%%r@%%h-%%p" % CACHE_DIR,
        "-o", "ControlPersist=300",
        remote(),
    ]


# `ssh machine command` runs a non-interactive, non-login shell: it reads
# neither .zshrc nor .bashrc, so its PATH is the system minimum. A herdr
# installed in ~/.local/bin -- which is where its installer tends to put it --
# simply does not exist on that side, and the error reads "command not found"
# on a machine where the binary is right there, visible to you.
#
# So the absolute path is discovered once and kept: paying for a login shell
# on every refresh would be expensive, and guessing the directory would be
# worse.
HERDR_SEARCH = (
    'command -v herdr 2>/dev/null || '
    'for p in "$HOME/.local/bin/herdr" /usr/bin/herdr /usr/local/bin/herdr "$HOME/bin/herdr"; '
    'do [ -x "$p" ] && printf %s "$p" && break; done'
)

_HERDR_BY_TARGET = {}
_HERDR_LOCK = threading.Lock()


def remote_state_path():
    return os.path.join(CACHE_DIR, "remote-%s.json" % scope())


def discover_herdr():
    """Absolute path of herdr on the other end, or "" when there is none."""
    argv = ssh_prefix() + ['exec "$SHELL" -lc ' + shlex.quote(HERDR_SEARCH)]
    code, out, _ = run(argv, TIMEOUT_SSH)
    found = out.strip().splitlines()[-1].strip() if code == 0 and out.strip() else ""
    return found if found.startswith("/") else ""


def remote_herdr(rediscover=False):
    target = remote()

    with _HERDR_LOCK:
        if rediscover:
            _HERDR_BY_TARGET.pop(target, None)
            stored = read_json(remote_state_path(), teto=64 * 1024)
            stored.pop("herdr", None)
            write_json(remote_state_path(), stored)
        elif target in _HERDR_BY_TARGET:
            return _HERDR_BY_TARGET[target]

        stored = read_json(remote_state_path(), teto=64 * 1024).get("herdr")
        if isinstance(stored, str) and stored.startswith("/"):
            _HERDR_BY_TARGET[target] = stored
            return stored

    found = discover_herdr()
    if found:
        with _HERDR_LOCK:
            stored = read_json(remote_state_path(), teto=64 * 1024)
            stored.update({"herdr": found, "ts": time.time()})
            write_json(remote_state_path(), stored)
            _HERDR_BY_TARGET[target] = found
        log_event("herdr-remote-found", path=found)
    # Without discovery, try the bare name anyway: if the minimum PATH reaches it,
    # it works; if not, the error that comes back is the right one.
    return found or "herdr"


def call_herdr(*args, _retentou=False):
    """Runs the Herdr CLI, here or on the other end. Returns (code, out, err)."""
    if not remote():
        parts = ["herdr"]
        if SESSION != DEFAULT_SESSION:
            parts += ["--session", SESSION]
        return run(parts + [str(a) for a in args], TIMEOUT_HERDR)

    parts = [remote_herdr()]
    if SESSION != DEFAULT_SESSION:
        parts += ["--session", SESSION]
    parts += [str(a) for a in args]

    # One single string: ssh's command goes through a shell on the other end, so
    # every argument is quoted to arrive intact.
    resultado = run(ssh_prefix() + [" ".join(shlex.quote(p) for p in parts)], TIMEOUT_SSH)

    # The stored path can go stale -- an update, a reinstall under another prefix.
    # One rediscovery before giving up costs a login shell and avoids a widget
    # that only works again after clearing the cache by hand.
    lowered = (resultado[1] + resultado[2]).lower()
    if not _retentou and ("command not found" in lowered or "no such file or directory" in lowered):
        remote_herdr(rediscover=True)
        return call_herdr(*args, _retentou=True)

    return resultado


# An SSH error on its own is a dead end in a status bar: nobody fixes
# "Host key verification failed" by looking at it. The hint that goes with it
# is the command that resolves it.
SSH_HINTS = (
    # The two Tailscale SSH ones come first because its message also matches the
    # more generic needles below, and the specific hint is the useful one.
    ("additional check", 'Tailscale ACL on "check": switch it to "accept", or the widget will never get through'),
    ("login.tailscale.com", 'Tailscale wants browser re-authentication; for a widget, use action "accept"'),
    ("host key verification", "run `ssh %s` once to accept the host key"),
    # A rejected key is the symptom of "I thought Tailscale SSH was on there":
    # without `tailscale up --ssh` on the target, what answers is the plain sshd.
    ("permission denied", "`ssh-copy-id %s`, ou `sudo tailscale up --ssh` nessa machine"),
    ("could not resolve", "the name does not resolve — is Tailscale up?"),
    ("name or service not known", "the name does not resolve — is Tailscale up?"),
    ("connection timed out", "machine is down or off the tailnet"),
    ("connection refused", "no SSH server listening on %s"),
    # It has to be the shell's phrase, not a loose "not found": Herdr itself
    # answers "agent target w2:p9 not found", which has nothing to do with where
    # the binary is.
    ("command not found", "no herdr over there, not even in ~/.local/bin — is it installed?"),
    ("no such file or directory", "the stored path of the remote herdr no longer exists"),
    ("timed out", "no answer in time — is the machine awake?"),
)


def error_from(code, out, err):
    message = (err or out or "herdr exited with %d" % code).strip()[:200]
    if not remote():
        return message

    lowered = message.lower()
    for needle, hint in SSH_HINTS:
        if needle in lowered:
            return "%s: %s — %s" % (remote(), message, hint.replace("%s", remote()))
    return "%s: %s" % (remote(), message)


def herdr_text(*args):
    """For commands returning raw text rather than JSON -- `pane read`.

    Text on success, but failure still arrives as Herdr's JSON envelope, so it
    is unwrapped here too. Otherwise the panel's status line showed a raw
    `{"error":{"code":...}}` blob where a sentence belonged.
    """
    code, out, err = call_herdr(*args)
    if code == 0:
        return (out, "")

    body = json_from(out) or json_from(err)
    if isinstance(body, dict) and isinstance(body.get("error"), dict):
        detail = body["error"]
        message = detail.get("message") or detail.get("code") or "herdr error"
        return ("", ("%s: %s" % (remote(), message)) if remote() else message)

    return ("", error_from(code, out, err))


def herdr(*args):
    """Calls the Herdr CLI and returns (payload, error_message)."""
    code, out, err = call_herdr(*args)
    body = json_from(out) or json_from(err) or {}

    if isinstance(body, dict) and isinstance(body.get("error"), dict):
        detail = body["error"]
        return (None, detail.get("message") or detail.get("code") or "err do herdr")
    if code != 0:
        return (None, error_from(code, out, err))
    if not isinstance(body, dict):
        return (None, "the herdr reply was not JSON")

    return (body.get("result") or {}, "")


def numbers_in(value):
    """"w2:t10" -> (2, 10). Orders the list the way Herdr shows the session."""
    return tuple(int(n) for n in re.findall(r"\d+", str(value or ""))) or (0,)


# --------------------------------------------------------------- messages


# Who spoke. The first set is how agents mark their own message (Claude, Codex
# and relatives); the second is how they mark yours.
AGENT_MARKS = "●⏺◍⦿"
YOUR_MARKS = ">❯»"

# Lines that are chrome, not conversation: rules, the input box, the shortcut
# footer, the token counter, the spinner and the automatic recap. They close
# the open block instead of entering it.
RE_RULE = re.compile(r"^[\s─━═╌╍‾_\-]{20,}$")
RE_BOX = re.compile(r"^[\s\u2500-\u257f]+$")
RE_FOOTER = re.compile(r"^\s*(⏵|\?\s|esc |ctrl|shift|tab )", re.IGNORECASE)
RE_SPINNER = re.compile(r"^\s*[✻✽✢✳❉*·⧗⣿]\s")
RE_RECAP = re.compile(r"^\s*※")
RE_TOOL = re.compile(r"^\s*[⎿⧉↳]")


def is_chrome(line):
    if not line.strip():
        return False
    return bool(
        RE_RULE.match(line)
        or RE_BOX.match(line)
        or RE_FOOTER.match(line)
        or RE_SPINNER.match(line)
        or RE_RECAP.match(line)
        or RE_TOOL.match(line)
        # "❯ 1. Yes" starts with the same "❯" that marks your message. Without this
        # line the whole dialog enters the list as if it were the last thing you
        # said -- taking the place of what the agent actually said before stopping
        # to ask.
        or RE_OPTION.match(line)
    )


def speaker(line):
    """'agent', 'you' or None -- who starts speaking on this line.

    The marker has to sit in the margin: an arrow or a bullet in the middle of
    a paragraph is content, not the start of a new message.
    """
    sem_recuo = line.lstrip(" ")
    if len(line) - len(sem_recuo) > 2 or not sem_recuo or RE_OPTION.match(line):
        return None
    head = sem_recuo[0]
    rest = sem_recuo[1:].strip()
    if head in AGENT_MARKS:
        return "agent"
    # "❯" alone is the empty prompt waiting for you, not a message.
    if head in YOUR_MARKS and rest:
        return "you"
    return None


def without_speaker(line):
    return line.lstrip(" ")[1:].strip()


def messages_from(raw, how_many):
    """The last `how_many` messages visible in the agent's terminal.

    What can be read is what is on screen: an agent on the alternate screen
    leaves no scrollback, so asking for more lines brings no more history. That
    matches the purpose -- the list shows what you would see if you focused the
    tab, no more and no less.
    """
    blocks = []
    current = None

    for line in (raw or "").splitlines():
        who = speaker(line)
        if who:
            current = {"who": who, "lines": [without_speaker(line)]}
            blocks.append(current)
        elif current is None:
            continue
        elif is_chrome(line) or not line.strip():
            # Only the first paragraph. After it comes the detail -- lists, tables, code
            # blocks -- which in one popup line would be noise: the headline is what
            # answers "what is going on over there".
            current = None
        else:
            current["lines"].append(line.strip())

    out = []
    for block in blocks[-max(1, how_many):]:
        text = re.sub(r"\s+", " ", " ".join(block["lines"])).strip()
        if not text:
            continue
        if len(text) > MAX_MESSAGE:
            text = text[:MAX_MESSAGE - 1].rstrip() + "…"
        out.append({"who": block["who"], "text": text})

    return out


# One dialog option: "❯ 1. Yes" / "  2. No, and tell Claude ...".
RE_OPTION = re.compile(r"^\s*(?P<cursor>[❯>»])?\s*(?P<key>\d{1,2})[.)]\s+(?P<label>\S.*?)\s*$")
# Only the box's vertical bars, never the indent: unnumbered options are
# recognised by the column where their text starts, and a generic strip()
# would erase exactly what identifies them.
RE_BORDER_LEFT = re.compile(r"^\s*[│┃┆┇┊┋╎╏║]\s?")
RE_BORDER_RIGHT = re.compile(r"\s*[│┃┆┇┊┋╎╏║]\s*$")

# Options that answer nothing on their own: choosing one opens a field and
# waits for you to write. Pressing the key and stopping there leaves the agent
# stuck on an empty input, which is worse than having no button.
RE_ASKS_TEXT = re.compile(
    r"(?i)(tell claude|tell it|chat about|what to change|what to do differently"
    r"|add notes|give feedback|explain|escrever|reply)"
)

# The dialog's own footer: keyboard instructions, neither question nor option.
RE_KEYHINT = re.compile(
    r"(?i)(esc to cancel|enter to (confirm|select|submit)|to navigate|to amend|to explain|for shortcuts)"
)


def unbox(line, styles=None):
    """Tira a moldura da caixa: "│ ❯ 1. Yes        │" -> "❯ 1. Yes".

    Corta o style nos mesmos indices do text: os dois andam char a
    char, e um deslocamento de um pinta a line inteira errado.
    """
    esquerda = RE_BORDER_LEFT.match(line)
    start = esquerda.end() if esquerda else 0
    direita = RE_BORDER_RIGHT.search(line, start)
    end = direita.start() if direita else len(line)
    if styles is None:
        return line[start:end]
    return (line[start:end], styles[start:end])


def numbered_options(lines):
    """The "❯ 1. Yes" / "  2. No" shape: the number is the key itself."""
    found_options = []
    for index, line in enumerate(lines):
        matched = RE_OPTION.match(line)
        if matched and not RE_KEYHINT.search(line):
            rotulo = matched.group("label")[:MAX_LABEL]
            found_options.append((index, {
                "key": matched.group("key"),
                "label": rotulo,
                "selected": matched.group("cursor") is not None,
                "prompts": bool(RE_ASKS_TEXT.search(rotulo)),
            }))
    return found_options


def cursor_options(lines):
    """The unnumbered shape: a "❯" marks the chosen one and its siblings align to it.

    This is Claude Code's folder-trust dialog, among others. With no number to
    type, answering means walking the arrows to the line and pressing Enter --
    which is why siblings are recognised by the column where their text starts
    and not by a marker: it is the only thing they share with the chosen one.
    """
    cursor = -1
    for index, line in enumerate(lines):
        if re.match(r"^\s*[❯>»]\s+\S", line) and not RE_KEYHINT.search(line):
            cursor = index
    if cursor < 0:
        return []

    marked = re.match(r"^(\s*[❯>»]\s+)(\S.*?)\s*$", lines[cursor])
    coluna = len(marked.group(1))

    def irma(line):
        if not line.strip() or RE_KEYHINT.search(line):
            return None
        matched = re.match(r"^(\s*)(\S.*?)\s*$", line)
        return matched.group(2) if matched and len(matched.group(1)) == coluna else None

    block = [(cursor, marked.group(2), True)]
    for step, limit in ((-1, -1), (1, len(lines))):
        index = cursor + step
        while index != limit:
            text = irma(lines[index])
            if text is None:
                break
            block.append((index, text, False))
            index += step

    block.sort()
    # A menu needs a choice: a marked line with no siblings is the prompt waiting
    # for you, and treating it as an option makes the panel offer a button that
    # answers nothing.
    if len(block) < 2:
        return []
    return [
        (
            index,
            {
                "key": "",
                "label": text[:MAX_LABEL],
                "selected": marcada,
                "prompts": bool(RE_ASKS_TEXT.search(text)),
            },
        )
        for index, text, marcada in block
    ]


def dialog_form(raw, quantas_linhas=40):
    """A stopped agent's question and options.

    Herdr classifies as `blocked` whatever it recognises as an approval or a
    question; here we only read what is already drawn on screen and turn it
    into buttons. An agent that asks some other way -- "[y/n]", free text --
    yields no options at all, and the field is left, which answers anything.
    """
    pairs = [unbox(*tokenize(l)) for l in (raw or "").splitlines()][-quantas_linhas:]
    lines = [t for t, _ in pairs]
    styles = [e for _, e in pairs]

    found_options = numbered_options(lines) or cursor_options(lines)
    if not found_options:
        # With no recognisable option -- "[y/N]", running text -- there is still a
        # question on screen, and it is what you need to read. No button is honest;
        # no question is just hiding what happened.
        return {"question": question_from(lines), "options": [], "context": context_from(lines, styles)}

    first_option = found_options[0][0]
    options = [option for _, option in found_options][:8]
    for position, option in enumerate(options):
        option["index"] = position

    return {
        "question": question_from(lines[:first_option]),
        "options": options,
        "context": context_from(lines[:first_option], styles[:first_option]),
    }


# --------------------------------------------------------------------- color


RE_SGR = re.compile(r"\x1b\[([0-9;]*)m")
RE_OTHER_ESCAPE = re.compile(r"\x1b\[[0-9;?]*[a-ln-zA-Z]|\x1b[\]P][^\x07\x1b]*(?:\x07|\x1b\\)?")


def tokenize(line):
    """Splits an ANSI line into (clean text, style per character).

    The terminal already painted the code -- Claude Code highlights diffs and
    command blocks -- so the right color is the one already there.
    Reimplementing a highlighter here would mean guessing again what the other
    end already knows.
    """
    # Other than SGR, every escape is cursor movement and the like: it paints
    # nothing and takes no column, so it goes before counting characters.
    limpa = RE_OTHER_ESCAPE.sub("", line)

    text = []
    styles = []
    style = {}

    # split with one group returns text and params alternating, starting with
    # text -- hence even index is content and odd is SGR.
    for index, pedaco in enumerate(RE_SGR.split(limpa)):
        if index % 2:
            style = apply_sgr(style, pedaco)
        else:
            text.append(pedaco)
            styles.extend([style] * len(pedaco))

    return ("".join(text), styles)


def apply_sgr(style, params):
    """One SGR over the current style. Only what changes reading: color, bold, dim."""
    codes = [c for c in params.split(";") if c != ""] or ["0"]
    updated = dict(style)
    index = 0

    while index < len(codes):
        code = codes[index]
        if code == "0":
            updated = {}
        elif code == "1":
            updated["b"] = True
        elif code == "2":
            updated["d"] = True
        elif code in ("22", "21"):
            updated.pop("b", None)
            updated.pop("d", None)
        elif code in ("39", "49"):
            updated.pop("f" if code == "39" else "g", None)
        elif code in ("38", "48") and index + 4 < len(codes) and codes[index + 1] == "2":
            key = "f" if code == "38" else "g"
            updated[key] = "#%02x%02x%02x" % tuple(min(255, int(c or 0)) for c in codes[index + 2:index + 5])
            index += 4
        index += 1

    return updated


def into_runs(text, styles):
    """Merges neighbouring characters of equal style, so the JSON is not one per letter."""
    runs = []
    for char, style in zip(text, styles):
        if runs and runs[-1][1] == style:
            runs[-1][0] += char
        else:
            runs.append([char, style])
    return [dict(style, t=text) for text, style in runs]


def context_from(above, styles):
    """Everything the dialog shows before the question, as it is on screen.

    It is the command it wants to run, the diff it wants to apply, the "Tip:"
    that changes what you would choose. Before, only the question came up, and
    "Do you want to proceed?" on its own is not a question -- it is the half of
    it that informs nothing. Lines come separated, not glued into a paragraph:
    a command block with its breaks undone is unreadable.
    """
    start, _ = question_span(above)
    corte = start if start >= 0 else len(above)

    useful = [(t.rstrip(), e[:len(t.rstrip())]) for t, e in zip(above[:corte], styles[:corte]) if is_text(t)]
    # The bottom ones are what matter: the command sits against the question, and
    # what is far above is conversation history, not the request.
    useful = useful[-MAX_CONTEXT:]
    if not useful:
        return []

    # Strip the common indent and keep the relative one: the dialog box already
    # pushed everything inward, and repeating that here would only cost width --
    # but the command's internal indentation is what makes it readable.
    indent = min(len(t) - len(t.lstrip(" ")) for t, _ in useful)
    return [
        into_runs(t[indent:][:MAX_MESSAGE], e[indent:][:MAX_MESSAGE])
        for t, e in useful
    ]


def is_text(line):
    """A line that counts as question text: neither empty nor chrome.

    Without discarding chrome, a rule between the question and the input box
    would enter the paragraph and the question's "text" would come with an
    eighty-character dash through the middle.
    """
    return bool(line.strip()) and not RE_KEYHINT.search(line) and not is_chrome(line)


def question_span(above):
    """(start, end) of the question paragraph, or (-1, -1) when there is none.

    The anchor is the line with "?" nearest the option block -- anywhere in it,
    not at the end, because a long question wraps across lines and the "?"
    lands in the middle of the first. From there the whole paragraph: showing
    half a question is worse than showing none, because the half that survives
    looks like the whole question and you answer something else.
    """
    # Dialog text is never attributed to anyone: a line starting with "●" or "❯"
    # is speech, and speech with a "?" in it is just a question someone asked in
    # the conversation -- not the one the screen is waiting on.
    target = -1
    for index in range(len(above) - 1, max(-1, len(above) - 13), -1):
        if is_text(above[index]) and "?" in above[index] and not speaker(above[index]):
            target = index
            break
    # With no "?" anywhere there is no question. This used to fall back to the
    # last line of any text, and on a pane Herdr marked blocked by mistake that
    # became a "question" made of loose conversation -- a guess that looks like
    # information.
    if target < 0:
        return (-1, -1)

    start = target
    while start > 0 and is_text(above[start - 1]) and not speaker(above[start - 1]):
        start -= 1
    end = target
    while end + 1 < len(above) and is_text(above[end + 1]) and not speaker(above[end + 1]):
        end += 1
    return (start, end)


def question_from(above):
    start, end = question_span(above)
    if start < 0:
        return ""
    joined = " ".join(line.strip() for line in above[start:end + 1])
    return re.sub(r"\s+", " ", joined).strip()[:MAX_QUESTION]


# ------------------------------------------------------- conversation history
#
# The messages do not come from the terminal. They used to, and it cost the two
# things this list needs most: the screen carries no clock, so no message could
# say when it happened, and an agent runs on the alternate screen, which keeps
# no scrollback -- asking `pane read` for 5000 lines returns the same thirty it
# returns for 90. There was nothing further back to fetch, ever.
#
# Claude Code writes every session to ~/.claude/projects/<encoded cwd>/<id>.jsonl,
# one JSON object per line, each with its timestamp. That is the real history:
# complete, dated, and already on disk. The terminal is still read for the
# blocked dialog, which is a thing on the screen and nowhere else.
#
# Which file belongs to which pane is the one hard part. The join is the title:
# Claude Code names the session and sets the terminal title from that name, so
# Herdr's pane title and the transcript's last `ai-title` are the same string.
# Fifteen messages, and past that the terminal. Reading a whole conversation is
# what the terminal is for; this list exists to tell you which one to go to. The
# ceiling is also what keeps an open row cheap -- fifty messages of rich text
# laid out on every refresh was slower than anything the panel does.
TRANSCRIPT_FIRST = 15

# The reader runs identically here and over SSH, so it is a self-contained
# script rather than a function: one process per machine per refresh answers
# for every agent on it, instead of a round trip each.
TRANSCRIPT_SCRIPT = r"""
import json, os, re, sys, glob

ROOT = os.path.expanduser("~/.claude/projects")
START = 256 * 1024


def tail(path, size):
    with open(path, "rb") as fh:
        fh.seek(0, 2)
        total = fh.tell()
        fh.seek(max(0, total - size))
        raw = fh.read()
    # A tail almost always starts mid-line; that fragment is not JSON.
    if total > size:
        cut = raw.find(b"\n")
        raw = raw[cut + 1:] if cut >= 0 else b""
    return raw.decode("utf-8", "replace"), total <= size


def text_of(block):
    if isinstance(block, str):
        return block
    if isinstance(block, dict) and block.get("type") == "text":
        return block.get("text") or ""
    return ""


def parse(raw):
    out = []
    title = ""
    for line in raw.split("\n"):
        line = line.strip()
        if not line:
            continue
        try:
            d = json.loads(line)
        except Exception:
            continue

        if d.get("type") == "ai-title":
            title = d.get("aiTitle") or title
            continue
        if d.get("type") not in ("user", "assistant"):
            continue
        # A subagent's conversation is not this pane's conversation.
        if d.get("isSidechain"):
            continue

        content = (d.get("message") or {}).get("content")
        blocks = content if isinstance(content, list) else [content]
        body = "\n".join(t for t in (text_of(b) for b in blocks) if t).strip()
        if not body:
            continue
        # Machine-addressed envelopes: reminders, command wrappers, the hook
        # output the model reads and nobody writes.
        if body.startswith("<") and body.endswith(">"):
            continue

        out.append({"who": "you" if d.get("type") == "user" else "agent",
                    "ts": d.get("timestamp") or "", "text": body})

    # The same prompt is written twice when it was queued and then sent. They
    # are not two messages and must not draw two gaps on the timeline.
    clean = []
    for m in out:
        if any(o["who"] == m["who"] and o["text"] == m["text"] for o in clean[-4:]):
            continue
        clean.append(m)
    return clean, title


def normal(value):
    return re.sub(r"\s+", " ", str(value or "")).strip().lower()


def session_for(dirs, want_title):
    # The working directory comes first and the pane's directory second. With
    # git worktrees they differ, and it is the working one that is right: nine
    # agents opened from ~/Projetos/api live in nine worktrees, each with its own
    # session directory. Asking by the pane's directory found the one shared
    # folder and answered the same conversation for all nine.
    files = []
    own = False
    for index, cwd in enumerate(dirs):
        if not cwd:
            continue
        folder = os.path.join(ROOT, re.sub(r"[^A-Za-z0-9]", "-", cwd))
        files = sorted(glob.glob(os.path.join(folder, "*.jsonl")),
                       key=os.path.getmtime, reverse=True)[:6]
        if files:
            # The first directory is where the agent actually works. With git
            # worktrees that is its own checkout, which belongs to this one
            # agent -- so whatever sessions are in it are its sessions.
            own = index == 0 and len(dirs) > 1 and dirs[0] != dirs[1]
            break
    if not files:
        return ""
    if not want_title or own:
        return files[0]

    for path in files:
        try:
            raw, _ = tail(path, 64 * 1024)
        except OSError:
            continue
        if normal(parse(raw)[1]) == normal(want_title):
            return path

    # Nothing matched the title. With a single session in the directory it is
    # that one -- a worktree holds one agent, and Herdr shows the branch name
    # where Claude Code would put its own. With several, guessing means showing
    # one agent's conversation on another agent's row, which is worse than
    # showing none: the terminal text is still there to fall back to.
    return files[0] if len(files) == 1 else ""


def history(dirs, want_title, limit, skip):
    path = session_for(dirs, want_title)
    if not path:
        return {"messages": [], "more": False, "found": False}

    need = limit + skip
    size = START
    while True:
        try:
            raw, whole = tail(path, size)
        except OSError:
            return {"messages": [], "more": False, "found": False}
        messages = parse(raw)[0]
        if len(messages) >= need + 1 or whole or size > 32 * 1024 * 1024:
            break
        size *= 4

    end = len(messages) - skip
    start = max(0, end - limit)
    return {"messages": messages[start:end] if end > 0 else [],
            "more": start > 0 or not whole,
            "found": True}


answer = {}
for item in json.loads(sys.stdin.read()):
    answer[item["key"]] = history(item.get("dirs") or [], item.get("title") or "",
                                  int(item.get("limit") or 50), int(item.get("skip") or 0))
sys.stdout.write(json.dumps(answer))
"""


def transcripts(wanted):
    """Answer several agents' history at once, here or on the machine in scope."""
    if not wanted:
        return {}

    argv = ["python3", "-c", TRANSCRIPT_SCRIPT]
    if remote():
        argv = ssh_prefix() + ["python3", "-c", shlex.quote(TRANSCRIPT_SCRIPT)]

    try:
        done = subprocess.run(
            argv, input=json.dumps(wanted), stdout=subprocess.PIPE,
            stderr=subprocess.PIPE, timeout=TIMEOUT_SSH if remote() else TIMEOUT_HERDR,
            text=True,
        )
    except (OSError, subprocess.SubprocessError) as erro:
        log_event("transcript-fail", error=str(erro))
        return {}

    if done.returncode != 0:
        log_event("transcript-fail", code=done.returncode, err=(done.stderr or "")[:200])
        return {}
    try:
        return json.loads(done.stdout or "{}")
    except ValueError:
        return {}


def read_terminal(pane, how_many, blocked_):
    """One read per agent: from it come the messages and, if stopped, the dialog."""
    # `pane read --format ansi` rather than `agent read`: same screen, but with
    # the colors the terminal already painted. Claude Code highlights diffs and
    # command blocks, and this is the only way for the panel to show highlighted
    # code without reimplementing a highlighter -- guessing again what the other
    # end already knows. The clean text comes out of the same read, so it costs
    # no second call.
    raw, err = herdr_text(
        "pane", "read", pane, "--source", "recent-unwrapped",
        "--lines", str(BUFFER_LINES), "--format", "ansi"
    )
    if err:
        return ([], {"question": "", "options": [], "context": []})
    empty = {"question": "", "options": [], "context": []}
    clean = RE_SGR.sub("", RE_OTHER_ESCAPE.sub("", raw))
    return (messages_from(clean, how_many), dialog_form(raw) if blocked_ else empty)


# ------------------------------------------------------------------ agents


def tab_labels(instantaneo):
    """tab_id -> label, only when the tab was renamed.

    An unnamed tab comes labelled with its own number ("1", "2"), which
    identifies nothing in a list -- worth less than the cwd's basename.
    """
    mapa = {}
    for tab in instantaneo.get("tabs") or []:
        rotulo = str(tab.get("label") or "").strip()
        if rotulo and not rotulo.isdigit():
            mapa[tab.get("tab_id")] = rotulo
    return mapa


def short_name(cwd):
    """Project name from the cwd. Home becomes "~".

    An agent running in home would show up as your username, which says nothing
    and still passes for a project name in a list where everything else is one.
    """
    if not cwd:
        return ""
    if not remote() and os.path.normpath(cwd) == os.path.normpath(os.path.expanduser("~")):
        return "~"
    return os.path.basename(cwd.rstrip("/"))


def agent_row(agent, tabs, prs):
    cwd = str(agent.get("cwd") or "")
    # Two directories, two purposes. `cwd` is where the pane opened and gives
    # the project its name; `foreground_cwd` is where the agent actually is,
    # which with git worktrees is a different branch under
    # .claude/worktrees/<branch>. Looking the PR up by `cwd` made every agent
    # in one repository resolve to the same branch -- usually main, usually no
    # PR -- which is why the column was empty on exactly the machine with the
    # most branches open.
    work_cwd = str(agent.get("foreground_cwd") or "") or cwd
    title = str(agent.get("terminal_title_stripped") or agent.get("terminal_title") or "").strip()
    project = tabs.get(agent.get("tab_id")) or short_name(cwd)

    status = str(agent.get("agent_status") or "unknown")
    if status not in STATUSES:
        status = "unknown"

    pr = prs.get(work_cwd) or prs.get(cwd) or {}

    return {
        "pane_id": str(agent.get("pane_id") or ""),
        "tab_id": str(agent.get("tab_id") or ""),
        "workspace_id": str(agent.get("workspace_id") or ""),
        "kind": str(agent.get("agent") or ""),
        "status": status,
        "cwd": cwd,
        "pr_cwd": work_cwd,
        "project": project,
        # The title would repeat the project when the tab was not renamed and the
        # agent did not touch the title; a column that repeats another only spends
        # width.
        "title": "" if title == project else title,
        "pr_number": int(pr.get("number") or 0),
        "pr_url": str(pr.get("url") or ""),
        "pr_title": str(pr.get("title") or ""),
        "pr_state": str(pr.get("state") or ""),
        "messages": [],
        "question": "",
        "options": [],
        "context": [],
    }


def prs_by_cwd(cache):
    """cwd -> PR entry, touching neither git nor the network.

    The cache stores the cwd that produced each entry precisely for this:
    finding the (repository, branch) key costs two `git rev-parse` calls, and
    the snapshot runs every few seconds while the popup is open.
    """
    mapa = {}
    for key, entry in cache.items():
        if key.startswith("_") or not isinstance(entry, dict):
            continue
        cwd = entry.get("cwd")
        if cwd:
            mapa[cwd] = entry
    return mapa


def build_snapshot():
    resultado, err = herdr("api", "snapshot")
    if err:
        return (None, err)

    instantaneo = (resultado or {}).get("snapshot") or {}
    tabs = tab_labels(instantaneo)
    cache = read_json(pr_cache_path())
    prs = prs_by_cwd(cache)

    lines = [agent_row(a, tabs, prs) for a in instantaneo.get("agents") or []]
    lines.sort(key=lambda l: (numbers_in(l["workspace_id"]), numbers_in(l["tab_id"]), numbers_in(l["pane_id"])))

    counts = {key: 0 for key in STATUSES}
    for line in lines:
        counts[line["status"]] += 1
    counts["total"] = len(lines)
    counts["ocioso"] = counts["idle"] + counts["done"]

    gh = cache.get("_gh")
    return (
        {
            "version": str(instantaneo.get("version") or ""),
            "counts": counts,
            "rows": lines,
            "gh": str(gh.get("state")) if isinstance(gh, dict) else "",
        },
        "",
    )


# ----------------------------------------------------------- default target


def resolve_default(lines):
    """Which row the text field uses.

    Matches on pane_id, and as a second try on cwd. A pane moved to another
    workspace gets a new pane_id, and the default target must not be lost in a
    layout reshuffle -- it is the same agent, in the same project.
    """
    saved = read_json(default_path(), teto=64 * 1024)
    pane = str(saved.get("pane_id") or "")
    cwd = str(saved.get("cwd") or "")

    if not pane and not cwd:
        return ("", "empty")

    for line in lines:
        if line["pane_id"] == pane:
            return (line["pane_id"], "pane")
    for line in lines:
        if cwd and line["cwd"] == cwd:
            return (line["pane_id"], "cwd")

    return ("", "morto")


# ------------------------------------------------------------ herdr window


def cmdline(pid):
    try:
        with open("/proc/%d/cmdline" % pid, "rb") as fh:
            raw = fh.read(8192)
    except OSError:
        return []
    return [parte.decode("utf-8", "replace") for parte in raw.split(b"\0") if parte]


def ppid(pid):
    try:
        with open("/proc/%d/stat" % pid, "rb") as fh:
            raw = fh.read(4096).decode("utf-8", "replace")
    except OSError:
        return 0
    # comm comes in parentheses and can contain spaces and parentheses; the only
    # safe cut is after the last ")".
    end = raw.rfind(")")
    if end < 0:
        return 0
    campos = raw[end + 2:].split()
    try:
        return int(campos[1])
    except (IndexError, ValueError):
        return 0


def values_of(args, name):
    """Todos os values_of de uma option repetida: --remote a --remote b."""
    out = []
    for index, arg in enumerate(args):
        if arg == name and index + 1 < len(args):
            out.append(args[index + 1])
    return out


def option(rest, name):
    """Valor de "--name value" ou "--name=value" numa lista de argumentos."""
    for index, arg in enumerate(rest):
        if arg == name and index + 1 < len(rest):
            return rest[index + 1]
        if arg.startswith(name + "="):
            return arg.split("=", 1)[1]
    return None


# ssh options that consume the next argument. Without this list, the "yes" of
# an "-o BatchMode=yes" would pass for a machine name.
SSH_TAKES_VALUE = frozenset(
    "-b -c -D -E -e -F -I -i -J -L -l -m -O -o -p -Q -R -S -W -w".split()
)


def ssh_target(argv):
    """(sessao, machine) de um `ssh [options] machine .../herdr [--session x]`."""
    machine = ""
    rest = []
    pular = False

    for index, arg in enumerate(argv[1:], start=1):
        if pular:
            pular = False
            continue
        if arg in SSH_TAKES_VALUE:
            pular = True
            continue
        if arg.startswith("-"):
            continue
        if not machine:
            machine = arg
            continue
        # First argument after the machine: the remote command. It only matters if it
        # is herdr -- an `ssh machine htop` is not a session window.
        if os.path.basename(arg) != "herdr":
            return None
        rest = argv[index + 1:]
        break
    else:
        # Ran out without finding a command: `ssh machine` opens a shell, not Herdr.
        return None

    return (option(rest, "--session") or DEFAULT_SESSION, machine) if machine else None


def client_target(argv):
    """(session, remote) of a Herdr client, or None when the process is not one.

    Three shapes count as a window of this session:

      herdr                      the local client
      herdr --remote target      the client from here, attached over there
      ssh [-t] target .../herdr  the client from over there, which this
                                 widget opens

    The server has no window and drops out. Ignoring any of the others would
    make the widget open a new terminal on top of one already sitting there.
    """
    if not argv:
        return None

    if os.path.basename(argv[0]) == "ssh":
        return ssh_target(argv)

    if os.path.basename(argv[0]) != "herdr":
        return None

    rest = argv[1:]
    if "server" in rest:
        return None

    sessao = option(rest, "--session")
    if sessao is None:
        for index, arg in enumerate(rest):
            if arg == "attach" and index > 0 and rest[index - 1] == "session" and index + 1 < len(rest):
                sessao = rest[index + 1]
                break
    # "--remote-keybindings" is not "--remote"; option() matches the whole name.
    return (sessao or DEFAULT_SESSION, option(rest, "--remote") or "")


def client_pids():
    encontrados = []
    try:
        entries = os.listdir("/proc")
    except OSError:
        return encontrados

    for entry in entries:
        if entry.isdigit() and client_target(cmdline(int(entry))) == (SESSION, remote()):
            encontrados.append(int(entry))
    return encontrados


def client_window():
    """Address of the Hyprland window hosting a client of this session.

    The Herdr client is the terminal emulator's grandchild (terminal -> shell
    -> herdr), so the link comes from walking the ppid chain until it lands on
    a pid the compositor knows. That holds for any terminal, which matching on
    class would not, and it is not fooled by a window that merely kept the
    title "herdr" after its herdr died. A terminal in server mode, with a
    single window for every tab, is the case this does not solve.
    """
    code, out, _ = run(["hyprctl", "-j", "clients"], TIMEOUT_HYPR)
    windows = json_from(out) if code == 0 else None
    if not isinstance(windows, list):
        return ""

    by_pid = {}
    for janela in windows:
        pid = janela.get("pid")
        if isinstance(pid, int) and pid > 0 and janela.get("mapped") is not False:
            by_pid.setdefault(pid, janela)

    candidates = []
    for pid in client_pids():
        current = pid
        for _ in range(20):
            if current in by_pid:
                candidates.append(by_pid[current])
                break
            parent = ppid(current)
            if parent <= 1 or parent == current:
                break
            current = parent

    if not candidates:
        return ""

    # focusHistoryID grows with time since last focus: 0 is the current window.
    # With more than one client open, the one you used last is the one you want.
    candidates.sort(key=lambda janela: janela.get("focusHistoryID", 1 << 30))
    return str(candidates[0].get("address") or "")


# ----------------------------------------------------------------------- prs


def gh_state():
    code, _, _ = run(["gh", "auth", "status"], TIMEOUT_GH)
    if code == 127:
        return "missing"
    return "ok" if code == 0 else "unauthenticated"


def repo_and_branch(cwd):
    if not cwd or not os.path.isdir(cwd):
        return ("", "")
    code, root_, _ = run(["git", "-C", cwd, "rev-parse", "--show-toplevel"], TIMEOUT_GIT)
    if code != 0:
        return ("", "")
    code, branch, _ = run(["git", "-C", cwd, "rev-parse", "--abbrev-ref", "HEAD"], TIMEOUT_GIT)
    if code != 0:
        return ("", "")
    root_, branch = root_.strip(), branch.strip()
    return (root_, branch) if root_ and branch and branch != "HEAD" else ("", "")


def claim_cwd(cache, key, cwd):
    """Makes `key` the only entry answering for `cwd`.

    Switching branch inside the same directory creates a second entry with the
    same cwd, and the snapshot would return whichever it found first -- the
    previous branch's PR, in a number that looks right and is not.
    """
    for outra, entry in cache.items():
        if outra != key and isinstance(entry, dict) and entry.get("cwd") == cwd:
            entry.pop("cwd", None)
    cache[key]["cwd"] = cwd


def prune(cache):
    if len(cache) <= MAX_CACHE_ENTRIES:
        return cache
    entries = [(c, e) for c, e in cache.items() if not c.startswith("_") and isinstance(e, dict)]
    entries.sort(key=lambda par: float(par[1].get("ts") or 0), reverse=True)
    podado = dict(entries[:MAX_CACHE_ENTRIES])
    if "_gh" in cache:
        podado["_gh"] = cache["_gh"]
    return podado


# ------------------------------------------------------------------ commands


def cmd_snapshot(args):
    data, err = build_snapshot()
    if err:
        empty = {key: 0 for key in list(STATUSES) + ["total", "ocioso"]}
        fail(err, counts=empty, rows=[], default="", default_state="empty", gh="")

    target, reason = resolve_default(data["rows"])
    for line in data["rows"]:
        line["is_default"] = line["pane_id"] == target

    if "--messages" in args:
        # Three messages for the field's target and one for the rest: it is the one
        # you will reply to, and replying needs the conversation, not the headline.
        for line in data["rows"][:MAX_READS]:
            messages, forma = read_terminal(
                line["pane_id"],
                3 if line["is_default"] else 1,
                line["status"] == "blocked",
            )
            line["messages"] = messages
            line["question"] = forma["question"]
            line["options"] = forma["options"]
            line["context"] = forma["context"]

    reply(default=target, default_state=reason, **data)


def cmd_focus(args):
    if not args:
        fail("focus needs a pane_id")

    # Focus goes to the server before the window exists, deliberately: when no
    # client is open, the new terminal comes up already rendering the right tab,
    # and there is no race between the attach and a focus arriving after it.
    _, err = herdr("agent", "focus", args[0])
    if err:
        fail(err)

    endereco = client_window()
    if endereco:
        # This Hyprland reads the dispatch argument as Lua; the old
        # "focuswindow address:0x..." form becomes a syntax error.
        run(
            ["hyprctl", "dispatch", 'hl.dsp.focus({ window = "address:%s" })' % endereco],
            TIMEOUT_HYPR,
        )
        log_event("focus", pane=args[0], janela=endereco)
        reply(action="focused", address=endereco)

    if remote():
        # `ssh -t` rather than `herdr --remote`: the former runs the client from over
        # there, which is the same version as the server over there, so there is
        # nothing to compare. `--remote` brings the client from here, and when the
        # versions differ it opens on a "[y/N] Install ... and stop the remote server
        # now?" -- a terminal stopping on a question is not "go to the agent".
        # Aligning versions would also fix it, but not always: a build with
        # self-update disabled will never align, and then the question is forever.
        #
        # The price is what --remote manages on its own: keepalive, multiplexing and
        # image paste. Whoever wants those opens `herdr --remote` by hand -- the
        # window is recognised just the same.
        comando_remoto = [remote_herdr()]
        if SESSION != DEFAULT_SESSION:
            comando_remoto += ["--session", SESSION]
        launch = ["omarchy-launch-terminal", "ssh", "-t", remote()] + comando_remoto
    else:
        launch = ["omarchy-launch-terminal", "herdr"]
        if SESSION != DEFAULT_SESSION:
            launch += ["--session", SESSION]
    # Detached, not awaited: opening a terminal is asking for a window to exist,
    # not running a command whose output matters. `omarchy-launch-terminal` goes
    # through uwsm and takes as long as it takes; waiting on it only produced a
    # timeout that killed the launch halfway -- which is exactly what happened.
    try:
        with open(LOG, "a") as out:
            subprocess.Popen(
                launch,
                stdin=subprocess.DEVNULL,
                stdout=out,
                stderr=out,
                start_new_session=True,
            )
    except OSError as err:
        fail("could not open the terminal: %s" % err, action="launch")

    log_event("terminal-aberto", pane=args[0], command=" ".join(launch))
    reply(action="launched")


def cmd_answer(args):
    """Chooses a dialog option, the way that dialog accepts it.

    Takes the position and the label that were on screen when you clicked, and
    rechecks both against the current buffer before pressing any key. A dialog
    can have changed between drawing the list and the click, and sending
    "down, down, Enter" into a different dialog approves something else.
    """
    with_text = "--with-text" in args
    args = [a for a in args if a != "--with-text"]

    if len(args) < 2:
        fail("answer needs a pane_id and a position")

    try:
        position = int(args[1])
    except ValueError:
        fail("invalid position: %s" % args[1][:16])
    expected = args[2] if len(args) > 2 else ""

    raw, err = herdr_text(
        "agent", "read", args[0], "--source", "detection", "--lines", str(BUFFER_LINES)
    )
    if err:
        fail(err)

    options = dialog_form(raw)["options"]
    if not 0 <= position < len(options):
        fail("the dialog changed — open the agent and answer there")

    chosen = options[position]
    if expected and chosen["label"] != expected:
        fail("the dialog changed — that option is now “%s”" % chosen["label"][:60])

    if chosen["key"]:
        # Numbered option: the number is the key itself, as you would type it.
        keys = [chosen["key"]]
    else:
        # Cursor list: walk to the line and confirm.
        current = next((i for i, o in enumerate(options) if o["selected"]), 0)
        step = "down" if position > current else "up"
        keys = [step] * abs(position - current) + ["enter"]

    _, err = herdr("agent", "send-keys", args[0], *keys)
    if err:
        fail(err)

    if not with_text:
        log_event("respondeu", pane=args[0], option=chosen["label"][:60])
        reply(answered=chosen["label"], keys=keys, pane_id=args[0])

    text = read_prompt()
    if not text:
        fail("chose “%s”, but no text came to write" % chosen["label"][:60])

    # The option was chosen; the agent is now drawing the field. Without waiting
    # for that, the text would be typed into the dialog still on screen -- and
    # letters become menu shortcuts instead of a sentence.
    if not waited_for_redraw(args[0], raw):
        fail("chose “%s”, but the screen did not change in time — the text was not sent"
               % chosen["label"][:60])

    _, err = herdr("pane", "send-text", args[0], text)
    if err:
        fail(err)
    _, err = herdr("pane", "send-keys", args[0], "enter")
    if err:
        fail(err)

    log_event("respondeu-escrevendo", pane=args[0], option=chosen["label"][:60])
    reply(answered=chosen["label"], keys=keys, wrote=True, pane_id=args[0])


def waited_for_redraw(pane, antes, limite_ms=3000, passo_ms=150):
    """Waits for the agent's screen to change after a keypress.

    The signal is the whole buffer changing, not the options disappearing:
    some screens keep the list and open the field beside it. A stopped agent
    has a still screen, so any change there is the answer to the key -- which
    would not hold for a working agent, whose spinner changes on its own.
    """
    spent = 0
    while spent < limite_ms:
        time.sleep(passo_ms / 1000.0)
        spent += passo_ms
        now, err = herdr_text(
            "agent", "read", pane, "--source", "detection", "--lines", str(BUFFER_LINES)
        )
        if err:
            return False
        if now != antes:
            return True
    return False


def cmd_send(args):
    if not args:
        fail("send needs a pane_id")

    text = read_prompt()
    if not text:
        fail("nothing to send")

    resultado, err = herdr("agent", "prompt", args[0], text)
    if not err:
        log_event("prompt", pane=args[0])
        reply(sent=True, pane_id=args[0], result=resultado)

    # An agent stopped in a dialog refuses a prompt with agent_blocked, and there
    # is no way to test first without a race: between the snapshot and the send it
    # may have stopped. So the path is to try, and only unblock on the refusal.
    if "blocked" not in err.lower():
        fail(err)

    # Esc is the way out the dialog itself offers -- Claude Code labels the last
    # option "No, and tell Claude what to do differently (esc)". It refuses what
    # was being asked and hands back the prompt, which is exactly what "reply
    # something else" means.
    _, erro_esc = herdr("agent", "send-keys", args[0], "esc")
    if erro_esc:
        fail(erro_esc)

    _, erro_espera = herdr("agent", "wait", args[0], "--until", "idle", "--timeout", "4000")
    if erro_espera:
        fail("refused the request, but the agent did not return to the prompt in time — the text was not sent")

    resultado, err = herdr("agent", "prompt", args[0], text)
    if err:
        fail(err)

    log_event("prompt-apos-recusa", pane=args[0])
    reply(sent=True, pane_id=args[0], result=resultado, rejected=True)


def cmd_default(args):
    if not args:
        fail("default needs a pane_id or -")

    if args[0] == "-":
        write_json(default_path(), {})
        reply(default="")

    data, err = build_snapshot()
    if err:
        fail(err)

    for line in data["rows"]:
        if line["pane_id"] == args[0]:
            write_json(default_path(), {"pane_id": line["pane_id"], "cwd": line["cwd"]})
            reply(default=line["pane_id"])

    fail("no agent in %s" % args[0])


# One round trip per machine instead of three per repository. Over SSH the
# difference is not the CPU, it is the latency: eight agents on four repos would
# be a dozen round trips, and this is a single one.
PR_SCRIPT = """
for d in %s; do
  root=$(git -C "$d" rev-parse --show-toplevel 2>/dev/null) || continue
  br=$(git -C "$d" rev-parse --abbrev-ref HEAD 2>/dev/null) || continue
  [ "$br" = HEAD ] && continue
  pr=$(cd "$d" 2>/dev/null && gh pr view --json number,url,title,state 2>/dev/null)
  printf '%%s\\t%%s\\t%%s\\t%%s\\n' "$d" "$root" "$br" "$pr"
done
"""


def pr_lookup(cwds):
    """(cwd, root, branch, pr json) for each directory, resolved where it lives.

    A remote Herdr has its repositories on the other end: the paths it returns
    do not exist here, so the lookup has to happen there. Which is also why it
    is one shell script over one connection rather than a call per repository.
    """
    if not cwds:
        return []

    script = PR_SCRIPT % " ".join(shlex.quote(c) for c in cwds)
    if remote():
        argv = ssh_prefix() + ['exec "$SHELL" -lc ' + shlex.quote(script)]
        timeout = TIMEOUT_GH + TIMEOUT_SSH
    else:
        argv = ["sh", "-c", script]
        timeout = TIMEOUT_GH + TIMEOUT_HERDR

    code, out, _ = run(argv, timeout)
    if code != 0:
        return []

    found = []
    for line in out.splitlines():
        parts = line.split("\t")
        if len(parts) == 4 and parts[1]:
            found.append((parts[0], parts[1], parts[2], json_from(parts[3]) or {}))
    return found


def refresh_prs_for(target):
    """Refreshes one machine's PR cache. Returns how many repositories it asked about."""
    use_remote(target)

    data, err = build_snapshot()
    if err:
        return 0

    cache = read_json(pr_cache_path())
    now = time.time()

    # Which directories are stale enough to be worth asking about. A PR never
    # changes number, so what expires is the "this branch has no PR yet".
    pending = []
    for line in data["rows"]:
        cwd = line.get("pr_cwd") or line["cwd"]
        if not cwd or cwd in pending:
            continue
        entry = prs_by_cwd(cache).get(cwd)
        if isinstance(entry, dict):
            ttl = PR_TTL if entry.get("number") else PR_TTL_EMPTY
            if now - float(entry.get("ts") or 0) < ttl:
                continue
        pending.append(cwd)

    for cwd, root_, branch, body in pr_lookup(pending[:MAX_REPOS_PER_RUN]):
        key = "%s\n%s" % (root_, branch)
        cache[key] = {
            "ts": now,
            "number": int(body["number"]) if isinstance(body.get("number"), int) else 0,
            "url": str(body.get("url") or ""),
            "title": str(body.get("title") or ""),
            "state": str(body.get("state") or ""),
        }
        claim_cwd(cache, key, cwd)

    write_json(pr_cache_path(), prune(cache))
    return len(pending[:MAX_REPOS_PER_RUN])


def cmd_prs(args):
    """Refreshes the PR cache of every machine that is on.

    The lookup runs where each repository lives, so a remote machine gets its
    numbers too. It used to give up on remotes -- the paths did not exist here,
    and running git on them would have lied -- but not asking at all left the
    column empty on exactly the machines with the most branches open.
    """
    targets = values_of(args, "--remote")
    if "--local" in args or not targets:
        targets.insert(0, "")

    if len(targets) == 1:
        queried = refresh_prs_for(targets[0])
    else:
        import concurrent.futures
        with concurrent.futures.ThreadPoolExecutor(max_workers=len(targets)) as pool:
            queried = sum(pool.map(refresh_prs_for, targets))

    use_remote("")
    reply(queried=queried, gh=gh_state())


# ------------------------------------------------------------ configuration

SHELL_JSON = os.path.expanduser("~/.config/omarchy/shell.json")
PLUGIN_ID = "otavio.quick-herdr"


def my_entry():
    """(section, index, entry) of this instance in shell.json.

    The bar hands the widget only `bar`, `moduleName` and `settings` -- not its
    position on the bar, which is what `setBarWidget` needs. So it is found
    again here: a plugin with allowMultiple can have several entries, and what
    tells mine apart from the others is exactly the `remote` I was given.
    """
    config = read_json(SHELL_JSON, teto=4 * 1024 * 1024)
    layout = ((config.get("bar") or {}).get("layout") or {})

    candidates = []
    for section in ("left", "center", "right"):
        for index, entry in enumerate(layout.get(section) or []):
            if isinstance(entry, dict) and entry.get("id") == PLUGIN_ID:
                candidates.append((section, index, entry))

    if not candidates:
        return (None, "this instance is not in shell.json")
    if len(candidates) == 1:
        return (candidates[0], "")

    same = [c for c in candidates if str(c[2].get("remote") or "") == remote()]
    if len(same) == 1:
        return (same[0], "")

    return (None, "there are %d copies of this widget on the same machine — edit shell.json" % len(candidates))


def cmd_config(args):
    found, err = my_entry()
    if err:
        fail(err)
    section, index, entry = found

    if not args or args[0] == "get":
        reply(section=section, index=index, settings=entry)

    if args[0] != "set" or len(args) < 3:
        fail("usage: config get | config set <key> <value> [--json]")

    key, raw = args[1], args[2]
    # With --json the value arrives structured: the machine list and the "this
    # machine" flag are not text, and sending "[\"a\"]" as a string would store
    # the string.
    if "--json" in args[3:]:
        value = json_from(raw)
        if value is None:
            fail("value is not JSON: %s" % raw[:80])
    else:
        value = raw
    placement = json.dumps({"section": section, "index": index})

    # The shell writes shell.json, not this process: it owns the file and reloads
    # on its own afterwards. Writing from outside would trample a concurrent
    # write of its own.
    code, out, stderr = run(
        ["omarchy-shell", "shell", "setBarWidget", PLUGIN_ID, key, json.dumps(value), placement],
        TIMEOUT_HERDR,
    )
    answer = (out or stderr).strip()
    if code != 0 or answer != "ok":
        fail(answer or "setBarWidget failed")

    log_event("config", key=key, value=value)
    reply(section=section, index=index, key=key, value=value)


def resolves(name):
    """O name short_ chega a algum lugar? Sem MagicDNS no search, so o FQDN vai."""
    return run(["getent", "hosts", name], 3)[0] == 0


# ------------------------------------------------------- several machines


def global_default_path():
    """O target do campo e um so para todas as machines, entao mora fora do scope."""
    return os.path.join(STATE_DIR, "default.json")


def one_snapshot(target, with_messages):
    """One machine's state, on its own thread.

    Runs in the same process as the others: the target lives in a thread-local,
    so two machines in parallel do not trip over each other. The previous
    version isolated with a subprocess per machine, which cost a whole Python
    interpreter per machine on every refresh -- more than the data it fetched.
    """
    use_remote(target)
    data, err = build_snapshot()
    if err:
        return {"ok": False, "error": err}

    if with_messages:
        # The terminal is still read, but only for the dialog: a blocked agent's
        # question and its options are drawn on the screen and exist nowhere else.
        for line in data["rows"][:MAX_READS]:
            fallback, forma = read_terminal(line["pane_id"], MAX_MESSAGES, line["status"] == "blocked")
            line["messages"] = fallback
            line["question"] = forma["question"]
            line["options"] = forma["options"]
            line["context"] = forma["context"]

        # One message per row is all a closed row shows, and a refresh that
        # carried fifty for every agent would put a few hundred kilobytes across
        # the SSH link every couple of seconds to draw one line each. A blocked
        # row opens by itself, so that one arrives ready to read.
        wanted = []
        for line in data["rows"][:MAX_READS]:
            if line["kind"] != "claude":
                continue
            wanted.append({
                "key": line["pane_id"],
                "dirs": [line["pr_cwd"], line["cwd"]],
                "title": line["title"] or line["project"],
                "limit": TRANSCRIPT_FIRST if line["status"] == "blocked" else 1,
                "skip": 0,
            })

        answers = transcripts(wanted)
        for line in data["rows"][:MAX_READS]:
            got = answers.get(line["pane_id"])
            # Only when the transcript actually answered: an agent that is not
            # Claude Code, or whose session file cannot be found, keeps the
            # terminal text -- worse, but not nothing.
            if got and got.get("found") and got.get("messages"):
                line["messages"] = got["messages"]
                line["more"] = bool(got.get("more"))

    data["ok"] = True
    return data


def cmd_all(args):
    """One single list, with the agents of every machine that is on.

    Machines are queried in parallel: with four on, waiting for one at a time
    would make the bar move at the speed of their sum.
    """
    import concurrent.futures

    with_messages = "--messages" in args
    targets = values_of(args, "--remote")
    if "--local" in args:
        targets.insert(0, "")
    if not targets:
        targets = [""]

    if len(targets) == 1:
        # A single machine pays for no thread at all.
        answers = [(targets[0], one_snapshot(targets[0], with_messages))]
    else:
        with concurrent.futures.ThreadPoolExecutor(max_workers=len(targets)) as pool:
            answers = list(pool.map(lambda a: (a, one_snapshot(a, with_messages)), targets))

    lines = []
    machines = []
    counts = {key: 0 for key in list(STATUSES) + ["total", "ocioso"]}
    gh = ""

    for target, data in answers:
        machines.append({
            "target": target,
            "ok": data.get("ok") is not False,
            "error": str(data.get("error") or ""),
        })
        if data.get("ok") is False:
            continue
        for key, value in (data.get("counts") or {}).items():
            if key in counts:
                counts[key] += int(value or 0)
        for line in data.get("rows") or []:
            line["machine"] = target
            lines.append(line)
        # The PR column is local by nature; a remote answers "remote" and has nothing
        # to say about repositories over here.
        if not target:
            gh = str(data.get("gh") or "")

    # Whoever is waiting on you first, then whoever is doing something, then
    # whoever finished, then the quiet ones. A stable sort, so inside each
    # state the rows keep the order Herdr itself shows (workspace, tab, pane)
    # and a machine's block does not shuffle on its own.
    #
    # The cost is real: a row moves when its agent changes state, which can
    # pull it out from under the cursor. That is the trade for the blocked one
    # always being the first thing you read.
    lines.sort(key=lambda l: URGENCY.get(l.get("status"), len(URGENCY)))

    alvo_padrao, reason = resolve_global_default(lines)
    for line in lines:
        line["is_default"] = (line["machine"], line["pane_id"]) == alvo_padrao

    reply(
        counts=counts,
        rows=lines,
        machines=machines,
        gh=gh,
        default=alvo_padrao[1],
        default_machine=alvo_padrao[0],
        default_state=reason,
    )


def resolve_global_default(lines):
    """(machine, pane) do target do campo, casando por pane e depois por cwd."""
    saved = read_json(global_default_path(), teto=64 * 1024)
    machine = str(saved.get("machine") or "")
    pane = str(saved.get("pane_id") or "")
    cwd = str(saved.get("cwd") or "")

    if not pane and not cwd:
        return (("", ""), "empty")

    for line in lines:
        if line["machine"] == machine and line["pane_id"] == pane:
            return ((machine, pane), "pane")
    for line in lines:
        if cwd and line["machine"] == machine and line["cwd"] == cwd:
            return ((machine, line["pane_id"]), "cwd")

    return (("", ""), "morto")


def cmd_open(args):
    """Open a file the conversation mentioned, wherever it lives.

    A remote path names a file that is not on this machine, so opening it
    directly would fail on a name that looks perfectly right. It is copied here
    first and the copy is what opens -- read-only by nature: editing it would
    edit a copy, and the panel does not pretend otherwise.
    """
    path = option(args, "--path") or ""
    target = option(args, "--remote") or ""
    if not path:
        fail("no file")

    # The line number belongs to the link, not to the filename.
    path = re.sub(r":\d+(?::\d+)?$", "", path)
    if path.startswith("~"):
        path = os.path.expanduser(path)

    local = path
    if target:
        use_remote(target)
        folder = os.path.join(CACHE_DIR, "files", re.sub(r"[^A-Za-z0-9]", "-", target))
        try:
            os.makedirs(folder, exist_ok=True)
        except OSError as erro:
            fail("cannot create the cache: %s" % erro)

        local = os.path.join(folder, os.path.basename(path) or "file")
        done = run(["scp", "-o", "BatchMode=yes", "-o", "ConnectTimeout=5",
                    "%s:%s" % (target, path), local], TIMEOUT_SSH)
        if done.returncode != 0:
            fail(error_from(done.returncode, done.stdout, done.stderr) or
                 "could not fetch %s from %s" % (path, target))

    if not os.path.exists(local):
        fail("no such file: %s" % path)

    try:
        subprocess.Popen(["xdg-open", local],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True)
    except OSError as erro:
        fail("could not open: %s" % erro)

    log_event("open", path=local, remote=target)
    reply(opened=local)


def cmd_history(args):
    """One agent's conversation, deeper than the refresh carries.

    Two calls, one gesture each. Opening a row asks for the first fifty;
    reaching the top of those asks for twenty-five older ones, with `--skip`
    saying how many are already on screen. The refresh keeps carrying one
    message per row, so neither of these is paid for by anybody who is only
    looking at the list.
    """
    target = option(args, "--remote") or ""
    pane = option(args, "--pane") or ""
    cwd = option(args, "--cwd") or ""
    title = option(args, "--title") or ""
    skip = int(option(args, "--skip") or 0)
    limit = int(option(args, "--limit") or TRANSCRIPT_FIRST)

    if not cwd:
        fail("no directory for this agent")

    use_remote(target)
    answer = transcripts([{"key": pane or "one", "dirs": [cwd, option(args, "--cwd2") or ""],
                           "title": title, "limit": limit, "skip": skip}])
    got = answer.get(pane or "one") or {}

    if not got.get("found"):
        # Not an error worth a red line: an agent that is not Claude Code has no
        # transcript to read, and saying so once is better than retrying forever.
        reply(messages=[], more=False, found=False,
              error="no session transcript for this agent")

    reply(messages=got.get("messages") or [], more=bool(got.get("more")), found=True)


def cmd_pick(args):
    """Grava o target do campo, que now precisa dizer tambem de qual machine."""
    if not args or args[0] == "-":
        write_json(global_default_path(), {})
        log_event("padrao-clean")
        reply(default="", default_machine="")

    machine = args[0] if args[0] != "." else ""
    if len(args) < 2:
        fail("pick needs the machine and the pane_id")

    write_json(global_default_path(), {"machine": machine, "pane_id": args[1], "cwd": args[2] if len(args) > 2 else ""})
    log_event("padrao", machine=machine or "local", pane=args[1])
    reply(default=args[1], default_machine=machine)


def cmd_disconnect(args):
    """Closes the multiplexed tunnel of a machine turned off in the list.

    Without this, ControlPersist holds the connection for a few more minutes
    after you untick the machine -- and "I turned it off" has to mean "it
    disconnected", not "it will disconnect eventually".
    """
    if not args:
        fail("disconnect needs a target")

    use_remote(args[0])
    code, _, err = run(ssh_prefix()[:-1] + ["-O", "exit", args[0]], TIMEOUT_HERDR)
    log_event("desconectado", target=args[0], code=code)
    # Exiting with an error here is the normal case: there was no tunnel open.
    reply(target=args[0], closed=code == 0, detail=err.strip()[:120])


def cmd_hosts(_args):
    """Candidates for `remote`, taken from Tailscale.

    Tailscale is the right answer here because the target has to keep working
    from any network: a LAN IP in shell.json breaks the first time you open the
    laptop somewhere else. Any target your ~/.ssh/config understands works too
    -- this is a suggestion, not the only door.
    """
    code, out, err = run(["tailscale", "status", "--json"], TIMEOUT_HERDR)
    if code == 127:
        fail("tailscale is not installed", hosts=[])
    body = json_from(out)
    if code != 0 or not isinstance(body, dict):
        fail((err or "tailscale status failed").strip()[:200], hosts=[])

    hosts = []
    for par in (body.get("Peer") or {}).values():
        if not isinstance(par, dict):
            continue
        dns = str(par.get("DNSName") or "").rstrip(".")
        if not dns:
            continue
        short_ = dns.split(".")[0]
        hosts.append({
            # The short name when MagicDNS resolves it, which is the normal case with
            # Tailscale up. "desktop" is a target you read, check and type;
            # "desktop.tailnet-abc123.ts.net" is one you copy and paste hoping you did
            # not get a letter wrong in the middle.
            "target": short_ if resolves(short_) else dns,
            "short": short_,
            "fqdn": dns,
            "name": str(par.get("HostName") or ""),
            "os": str(par.get("OS") or ""),
            "online": par.get("Online") is True,
        })

    hosts.sort(key=lambda h: (not h["online"], h["short"]))
    reply(hosts=hosts)


COMMANDS = {
    "snapshot": cmd_snapshot,
    "focus": cmd_focus,
    "send": cmd_send,
    "answer": cmd_answer,
    "default": cmd_default,
    "prs": cmd_prs,
    "hosts": cmd_hosts,
    "config": cmd_config,
    "all": cmd_all,
    "history": cmd_history,
    "open": cmd_open,
    "pick": cmd_pick,
    "disconnect": cmd_disconnect,
}


def main():
    global SESSION

    argv = sys.argv[1:]
    while len(argv) >= 2 and argv[0] in ("--session", "--remote"):
        if argv[0] == "--session":
            SESSION = argv[1]
        else:
            use_remote(argv[1])
        argv = argv[2:]

    if not argv or argv[0] not in COMMANDS:
        sys.stderr.write(__doc__)
        return 2

    COMMANDS[argv[0]](argv[1:])
    return 0


if __name__ == "__main__":
    sys.exit(main())
