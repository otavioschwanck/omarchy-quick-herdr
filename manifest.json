{
  "schemaVersion": 1,
  "id": "otavio.quick-herdr",
  "name": "Quick Herdr",
  "version": "4.0.0",
  "author": "otavio",
  "description": "Herdr agents from every machine in the Omarchy bar: what they are doing, what they last said, and the prompts they are waiting on.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "Quick Herdr",
    "description": "Herdr agents, local and over SSH; click to go to the tab, right click to open the conversation, and the field sends a prompt without focusing",
    "category": "Info",
    "allowMultiple": true,
    "defaultSection": "right",
    "defaults": {
      "machines": "",
      "local": true,
      "label": "",
      "session": "default",
      "interval": 4,
      "prInterval": 180,
      "maxRows": 20,
      "hideWhenEmpty": false
    },
    "schema": [
      {
        "key": "machines",
        "type": "string",
        "label": "SSH targets, space separated (empty = only this machine); `bin/herdr-bar hosts` lists the Tailscale ones"
      },
      {
        "key": "local",
        "type": "boolean",
        "label": "Include this machine's agents"
      },
      {
        "key": "label",
        "type": "string",
        "label": "Label on the bar, to tell instances apart"
      },
      {
        "key": "session",
        "type": "string",
        "label": "Herdr session"
      },
      {
        "key": "interval",
        "type": "number",
        "label": "Seconds between count refreshes"
      },
      {
        "key": "prInterval",
        "type": "number",
        "label": "Seconds between PR lookups (only with the list open)"
      },
      {
        "key": "maxRows",
        "type": "number",
        "label": "Rows in the list"
      },
      {
        "key": "hideWhenEmpty",
        "type": "boolean",
        "label": "Hide from the bar when there is no agent"
      }
    ]
  },
  "omarchy": {
    "clonePaths": [
      {
        "source": "Model.js",
        "target": "Model.js"
      },
      {
        "source": "bin/herdr-bar",
        "target": "bin/herdr-bar"
      }
    ]
  }
}
